{
  "name": "zlient",
  "version": "2.0.1",
  "homepage": "https://emirhangumus.github.io/zlient/",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirhangumus/zlient.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "rolldown": "^1.0.0-beta.9-commit.d91dfb5",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.26",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "zod": "^4.2.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/emirhangumus/zlient/issues"
  },
  "description": "A type-safe HTTP client framework with Zod validation for building robust API clients",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "http-client",
    "api-client",
    "zod",
    "validation",
    "typescript",
    "fetch",
    "rest-api",
    "type-safe",
    "schema-validation"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rolldown -c && tsc",
    "dev": "rolldown -c -w",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "lint": "eslint lib/**/*.ts",
    "lint:fix": "eslint lib/**/*.ts --fix",
    "format": "prettier --write \"lib/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "type": "module"
}
